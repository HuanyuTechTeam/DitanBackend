# 数据库配置
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=changeme123
DATABASE_NAME=ditan_db

# 应用配置
APP_NAME=DitanBackend
APP_VERSION=3.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=False

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# AI 模型配置
AI_API_KEY=YOUR_API_KEY
AI_BASE_URL=YOUR_BASE_URL
AI_MODEL_NAME=deepseek-flash

# JWT 认证配置
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Apkio 统一认证配置（过渡期可与本地 JWT 并行）
APKIO_AUTH_ENABLED=False
APKIO_JWT_SECRET_KEY=YOUR_APKIO_APP_SECRET_KEY
APKIO_JWT_ALGORITHM=HS256
APKIO_ORG_TOKEN_AUDIENCE=org
APKIO_REQUIRED_PERMISSION=ditan.access
APKIO_AUTO_CREATE_DOCTOR=True

# 独立病例上传验票，API 根地址必须包含 /api；无需新增 JWT 密钥
MEDICAL_UPLOAD_AUTH_REQUIRED=True
APKIO_BASE_URL=
# 仅本地开发显式允许 http://127.0.0.1:8000/api 等 loopback HTTP
APKIO_ALLOW_LOOPBACK_HTTP=False
